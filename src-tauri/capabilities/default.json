{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ZeroDesk default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "zerotier-cli",
          "cmd": "zerotier-cli",
          "args": true
        },
        {
          "name": "systemctl",
          "cmd": "systemctl",
          "args": true
        },
        {
          "name": "pkexec",
          "cmd": "pkexec",
          "args": true
        }
      ]
    },
    "shell:allow-spawn",
    "shell:allow-execute"
  ]
}
